{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BMS Cards",
  "version": "0.9.9-beta.7",
  "identifier": "com.ciga10.bmscards",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BMS Cards",
        "width": 1500,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 700,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,WebRtcHideLocalIpsWithMdns"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}