{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "app/js/parsers/*.js",
    "app/js/rules/*.js",
    "app/js/core/mapdtc.js",
    "app/js/core/organization.js",
    "app/js/core/prefs.js",
    "app/js/core/mapdata.js",
    "app/js/core/popup.js",
    "app/js/core/lethal.js",
    "app/js/core/strike.js",
    "app/js/core/coalitions.js",
    "app/js/bmsdata/exever.js"
  ]
}
